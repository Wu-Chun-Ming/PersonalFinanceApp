{
  "name": "personalfinanceapp",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "DARK_MODE=media expo start --web",
    "lint": "expo lint",
    "test": "jest --watch --coverage=false --verbose",
    "test:precommit": "jest --coverage=false",
    "test:unit": "jest --watch --coverage=false --verbose __tests__/unit",
    "testDebug": "jest -o --watch --coverage=false",
    "testFinal": "jest --verbose",
    "testFinal:unit": "jest --verbose __tests__/unit --coverageDirectory=coverage/unit",
    "updateSnapshots": "jest -u --coverage=false"
  },
  "dependencies": {
    "@expo/html-elements": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@gluestack-ui/core": "^3.0.10",
    "@gluestack-ui/utils": "^3.0.11",
    "@gluestack/ui-next-adapter": "^3.0.3",
    "@json2csv/plainjs": "^7.0.6",
    "@legendapp/motion": "^2.4.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/drawer": "^7.5.0",
    "@react-navigation/elements": "^2.9.14",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "@shopify/react-native-skia": "2.2.12",
    "@tanstack/react-query": "^5.81.5",
    "@testing-library/react-native": "^13.2.2",
    "@types/jest": "29.5.14",
    "babel-plugin-module-resolver": "^5.0.2",
    "csvtojson": "^2.0.14",
    "dayjs": "^1.11.13",
    "expo": "~54.0.33",
    "expo-asset": "~12.0.12",
    "expo-blur": "~15.0.8",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "formik": "^2.4.6",
    "jest": "^29.4.0",
    "jest-expo": "~54.0.17",
    "nativewind": "^4.1.23",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-collapsible": "^1.6.2",
    "react-native-element-dropdown": "^2.12.4",
    "react-native-executorch": "^0.8.0",
    "react-native-executorch-expo-resource-fetcher": "^0.8.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-gifted-charts": "^1.4.70",
    "react-native-popup-menu": "^0.19.0",
    "react-native-progress": "^5.0.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "^5.6.1",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "rrule": "^2.8.1",
    "tailwindcss": "^3.4.17",
    "victory-native": "^41.20.2",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.1.10",
    "eslint": "^9.36.0",
    "eslint-config-expo": "~10.0.0",
    "jscodeshift": "^0.15.2",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|@gluestack-ui|@legendapp/motion|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg))"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "**/*.{ts,tsx,js,jsx}",
      "!**/coverage/**",
      "!**/node_modules/**",
      "!**/babel.config.js",
      "!**/expo-env.d.ts",
      "!**/.expo/**",
      "!**/components/ui/**"
    ]
  },
  "private": true
}
